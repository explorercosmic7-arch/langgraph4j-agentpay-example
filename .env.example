# Copy to .env or export in your shell before running.
AGENTPAY_BASE_URL=https://autonomous-edge-agent-economy.explorercosmic7.workers.dev
AGENTPAY_API_KEY=a2a_YOUR_KEY_HERE

# Repos must exist / be fundable on your AgentPay deployment
AGENTPAY_BUYER_REPO=swarm/bot-1
AGENTPAY_WORKER_REPO=swarm/bot-2

# Escrow amount in USD
AGENTPAY_AMOUNT=0.05

# Optional: force failure path (refund instead of release)
# AGENTPAY_FORCE_FAIL=true
